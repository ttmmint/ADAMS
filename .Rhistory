# Install packages if necessary
# install.packages(c("tidyverse", "broom", "ggplot2", "car", "interactions", "psych", "lmtest"))
library(tidyverse)
library(broom)
library(ggplot2)
library(car)
library(interactions)
library(psych)
library(lmtest)
# Each decision in the multiverse is one argument of the pipeline.
# The options for each decision are listed here:
#
# D2 Grade:          keep all / exclude below 5.5 / exclude below 6.0
# D3 Comprehension:  keep all / exclude <= 7 (chance) / exclude <= 10 (not significantly above chance) / keep all, but add Comprehension as a predictor
# D5 Controls:       none / ReadNews / ReadNews + Age + Sexe
multiverse_options <- expand_grid(
grade         = c("keep", "5.5", "6.0"),
comprehension = c("keep", "exclude_7", "exclude_10", "covariate"),
controls      = c("none", "readnews", "demographic")
)
# Number of pathways: 3 x 4 x 3 = 36
nrow(multiverse_options)
# D2: remove participants whose average statistics grade is below the passing threshold
filter_grade <- function(df, grade) {
if (grade == "keep") return(df)
df %>% filter(GradeStats >= as.numeric(grade))
}
# D3: attention check. "Covariate" added in D5
filter_comprehension <- function(df, comprehension) {
if (comprehension == "exclude_7")  return(df %>% filter(Comprehension > 7))
if (comprehension == "exclude_10") return(df %>% filter(Comprehension > 10))
df
}
# D3 + D5: build the regression formula.
build_formula <- function(comprehension, controls) {
predictors <- "StatsCourses"
if (controls == "readnews")    predictors <- c(predictors, "ReadNews")
if (controls == "demographic") predictors <- c(predictors, "ReadNews", "Age", "Sexe")
if (comprehension == "covariate") predictors <- c(predictors, "Comprehension")
as.formula(paste("Judgment ~", paste(predictors, collapse = " + ")))
}
# Run one complete pathway: apply the data-processing steps in a fixed order (D2 -> D3)
run_pathway <- function(grade, comprehension, controls) {
df <- data %>%
filter_grade(grade) %>%
filter_comprehension(comprehension)
model <- lm(build_formula(comprehension, controls), data = df)
est   <- tidy(model, conf.int = TRUE) %>% filter(term == "StatsCourses")
tibble(
n         = nrow(df),
estimate  = est$estimate,
conf.low  = est$conf.low,
conf.high = est$conf.high,
t         = est$statistic,
p_one     = pt(est$statistic, df = model$df.residual, lower.tail = FALSE)
)
}
#Check original data
run_pathway("keep", "keep", "none")
c(goal    = sum(dat$GoalStudy == 1),
grade55 = sum(dat$GradeStats < 5.5),
grade60 = sum(dat$GradeStats < 6.0),
comp7   = sum(dat$Comprehension <= 7),
comp10  = sum(dat$Comprehension <= 10))
c(goal    = sum(data$GoalStudy == 1),
grade55 = sum(data$GradeStats < 5.5),
grade60 = sum(data$GradeStats < 6.0),
comp7   = sum(data$Comprehension <= 7),
comp10  = sum(data$Comprehension <= 10))
dat <- read.csv("A1_data.csv")
str(dat)
c(goal    = sum(dat$GoalStudy == 1),
grade55 = sum(dat$GradeStats < 5.5),
grade60 = sum(dat$GradeStats < 6.0),
comp7   = sum(dat$Comprehension <= 7),
comp10  = sum(dat$Comprehension <= 10))
grid <- expand.grid(
goal  = c("Keep", "Exclude"),
grade = c("Keep all", "< 5.5", "< 6.0"),
comp  = c("Keep all", "<= 7", "<= 10", "Covariate"),
covs  = c("None", "ReadNews", "ReadNews + Sexe"),
stringsAsFactors = FALSE
)
nrow(grid)
run_path <- function(goal, grade, comp, covs) {
d <- dat
if (goal == "Exclude") d <- d[d$GoalStudy == 0, ]
if (grade == "< 5.5")  d <- d[d$GradeStats >= 5.5, ]
if (grade == "< 6.0")  d <- d[d$GradeStats >= 6.0, ]
if (comp == "<= 7")    d <- d[d$Comprehension > 7, ]
if (comp == "<= 10")   d <- d[d$Comprehension > 10, ]
predictors <- c("StatsCourses",
if (comp == "Covariate") "Comprehension",
if (covs != "None") "ReadNews",
if (covs == "ReadNews + Sexe") "Sexe")
fit <- lm(reformulate(predictors, response = "Judgement"), data = d)
ci <- confint(fit)["StatsCourses", ]
data.frame(n        = nobs(fit),
estimate = coef(fit)[["StatsCourses"]],
lower    = ci[[1]],
upper    = ci[[2]],
p        = summary(fit)$coefficients["StatsCourses", "Pr(>|t|)"])
}
results <- cbind(grid, do.call(rbind, Map(run_path, grid$goal, grid$grade,
grid$comp, grid$covs)))
run_path <- function(goal, grade, comp, covs) {
d <- dat
if (goal == "Exclude") d <- d[d$GoalStudy == 0, ]
if (grade == "< 5.5")  d <- d[d$GradeStats >= 5.5, ]
if (grade == "< 6.0")  d <- d[d$GradeStats >= 6.0, ]
if (comp == "<= 7")    d <- d[d$Comprehension > 7, ]
if (comp == "<= 10")   d <- d[d$Comprehension > 10, ]
predictors <- c("StatsCourses",
if (comp == "Covariate") "Comprehension",
if (covs != "None") "ReadNews",
if (covs == "ReadNews + Sexe") "Sexe")
fit <- lm(reformulate(predictors, response = "Judgment"), data = d)
ci <- confint(fit)["StatsCourses", ]
data.frame(n        = nobs(fit),
estimate = coef(fit)[["StatsCourses"]],
lower    = ci[[1]],
upper    = ci[[2]],
p        = summary(fit)$coefficients["StatsCourses", "Pr(>|t|)"])
}
results <- cbind(grid, do.call(rbind, Map(run_path, grid$goal, grid$grade,
grid$comp, grid$covs)))
rownames(results) <- NULL
results$support <- results$estimate > 0 & results$p < .05
c(pathways      = nrow(results),
share_support = mean(results$support),
median_est    = median(results$estimate),
min_est       = min(results$estimate),
max_est       = max(results$estimate),
min_n         = min(results$n),
max_n         = max(results$n))
for (d in c("goal", "grade", "comp", "covs")) {
print(tapply(results$estimate, results[[d]], median))
}
results <- results[order(results$estimate), ]
results$rank <- seq_len(nrow(results))
top <- ggplot(results, aes(rank, estimate, colour = support)) +
geom_hline(yintercept = 0, linetype = "dashed") +
geom_pointrange(aes(ymin = lower, ymax = upper), size = 0.2) +
scale_colour_manual(values = c("TRUE" = "#4472C4", "FALSE" = "grey60"),
breaks = c("TRUE", "FALSE"),
labels = c("positive, p < .05", "not significant"),
name = NULL) +
labs(x = NULL, y = "Estimate for StatsCourses") +
theme_minimal() +
theme(legend.position = "top", axis.text.x = element_blank())
choices <- data.frame(
rank     = rep(results$rank, 4),
decision = rep(c("D1 Goal", "D2 Grade", "D3 Comprehension", "D4 Covariates"),
each = nrow(results)),
choice   = c(results$goal, results$grade, results$comp, results$covs)
)
bottom <- ggplot(choices, aes(rank, choice)) +
geom_point(shape = "|", size = 3) +
facet_grid(decision ~ ., scales = "free_y", space = "free_y") +
labs(x = "Pathway (sorted by estimate)", y = NULL) +
theme_minimal() +
theme(strip.text.y = element_text(angle = 0))
top / bottom + plot_layout(heights = c(2, 3))
